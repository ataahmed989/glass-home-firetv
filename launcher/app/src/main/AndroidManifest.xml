<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Weather, TMDB, ESPN and their artwork -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Control Center: network and Bluetooth status (normal permissions, granted at install) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Home button: which screen Fire OS has in front, when it says nothing else (granted once over ADB) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: without these the app grid comes up empty -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Fire TV's settings screen, for the Settings tile -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_SETTINGS" />
        </intent>
        <!-- Fire TV's screen mirroring, for the Control Center shortcut -->
        <package android:name="com.amazon.cast.sink" />
        <!-- The Appstore's storefront and Live TV's guide, which their tiles open directly -->
        <package android:name="com.amazon.venezia" />
        <package android:name="com.amazon.tv.livetv" />
        <!-- FirePlayer, whose title server is started again after Fire OS force-stops it -->
        <package android:name="app.fireplayer" />
        <!-- The Amazon apps turned off at setup (firetv/disabled-packages.txt), watched in case Fire OS turns them back on -->
        <package android:name="com.amazon.client.metrics.api" />
        <package android:name="com.amazon.device.telemetry.emitter" />
        <package android:name="com.amazon.dp.logger" />
        <package android:name="com.amazon.ceviche" />
        <package android:name="com.amazon.perfc" />
        <package android:name="com.amazon.perfcollection" />
        <package android:name="com.amazon.neo.minerva" />
        <package android:name="com.amazon.neo.minerva.logcat" />
        <package android:name="com.amazon.wirelessmetrics.service" />
        <package android:name="com.amazon.kso.blackbird" />
        <package android:name="com.amazon.hybridadidservice" />
        <package android:name="com.amazon.tv.acr" />
        <package android:name="com.amazon.bueller.photos" />
        <package android:name="com.amazon.bueller.music" />
        <package android:name="com.amazon.tv.ftvambient" />
        <package android:name="com.amazon.sneakpeek" />
        <package android:name="com.amazon.shoptv.client" />
        <package android:name="com.amazon.shoptv.firetv.client" />
        <package android:name="com.amazon.d3" />
        <package android:name="com.amazon.logan" />
        <package android:name="com.amazon.media.recommendations" />
        <package android:name="com.amazon.minitv.android.app" />
        <package android:name="com.amazon.gamehub" />
        <package android:name="com.amazon.tv.earlyaccess" />
        <package android:name="com.amazon.tv.releasenotes" />
        <package android:name="com.amazon.storm.lightning.tutorial" />
        <package android:name="com.amazon.tmm.tutorial" />
        <package android:name="com.amazon.smarthomemapviewapp" />
        <package android:name="com.android.protips" />
        <package android:name="com.android.printservice.recommendation" />
        <package android:name="com.amazon.tv.matter" />
        <package android:name="com.amazon.tv.mattercohost" />
        <package android:name="com.amazon.ods.kindleconnect" />
        <package android:name="com.amazon.rtcsessioncontroller" />
        <package android:name="com.amazon.tv.ffsprovisioneeclient" />
        <package android:name="com.android.traceur" />
        <package android:name="com.amazon.cloud9" />
        <package android:name="com.amazon.tahoe" />
    </queries>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Glass Home updates itself from its GitHub releases, through Fire OS's installer (see Updater) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Optional ADB grant; used only to repair the Home service settings. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GlassHome">

        <receiver android:name=".HomeServiceRecovery" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Launchable from Your Apps, and a home screen the Home button can be pointed at -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Control Center Sleep: allowed only to turn the screen off; granted once over ADB with
             "dpm set-active-admin app.glasshome.launcher/.SleepAdmin" and given back from Home Screen settings -->
        <receiver
            android:name=".SleepAdmin"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/sleep_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SleepTimerReceiver"
            android:exported="false" />

        <!-- Home button: brings Glass Home forward whenever Fire OS shows Amazon's home screen. Turned on
             once over ADB: "settings put secure enabled_accessibility_services
             app.glasshome.launcher/app.glasshome.launcher.HomeButtonService" -->
        <service
            android:name=".HomeButtonService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>
        <!-- Hands the downloaded update to Fire OS's installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
