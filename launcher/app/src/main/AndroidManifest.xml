<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Weather, TMDB, ESPN and their artwork -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Control Center: network and Bluetooth status (normal permissions, granted at install) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Home button: which screen Fire OS has in front, when it says nothing else (granted once over ADB) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: without these the app grid comes up empty -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Fire TV's settings screen, for the Settings tile -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_SETTINGS" />
        </intent>
        <!-- Fire TV's screen mirroring, for the Control Center shortcut -->
        <package android:name="com.amazon.cast.sink" />
        <!-- The Appstore's storefront and Live TV's guide, which their tiles open directly -->
        <package android:name="com.amazon.venezia" />
        <package android:name="com.amazon.tv.livetv" />
    </queries>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Settings' Remove Glass Home (friend TVs) opens Fire OS's uninstall screen -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Optional ADB grant; used only to repair the Home service settings. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GlassHome">

        <receiver android:name=".HomeServiceRecovery" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Source: the HDMI inputs, opened from Control Center -->
        <activity
            android:name=".SourceActivity"
            android:excludeFromRecents="true"
            android:taskAffinity="app.glasshome.launcher.source"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="landscape"
            android:label="Source"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launchable from Your Apps, and a home screen the Home button can be pointed at -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Continue Watching: sees what the streaming apps play (their media sessions). Fire TV has
             no screen to allow it, so it is granted once over ADB with
             "cmd notification allow_listener app.glasshome.launcher/app.glasshome.launcher.MediaWatcher". -->
        <service
            android:name=".MediaWatcher"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Control Center Sleep: allowed only to turn the screen off; granted once over ADB with
             "dpm set-active-admin app.glasshome.launcher/.SleepAdmin" and given back from Home Screen settings -->
        <receiver
            android:name=".SleepAdmin"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/sleep_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SleepTimerReceiver"
            android:exported="false" />

        <!-- Home button: brings Glass Home forward whenever Fire OS shows Amazon's home screen. Turned on
             once over ADB: "settings put secure enabled_accessibility_services
             app.glasshome.launcher/app.glasshome.launcher.HomeButtonService" -->
        <service
            android:name=".HomeButtonService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>
    </application>
</manifest>
