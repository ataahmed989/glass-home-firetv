<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Weather, TMDB, ESPN and their artwork -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Control Center: network and Bluetooth status (normal permissions, granted at install) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11+ package visibility: without these the app grid comes up empty -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Fire TV's screen mirroring, for the Control Center shortcut -->
        <package android:name="com.amazon.cast.sink" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GlassHome">

        <!-- Test build: launchable from Your Apps. The HOME category is added later,
             once Home-button support has been checked on this exact firmware. -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Continue Watching: sees what the streaming apps play (their media sessions). Fire TV has
             no screen to allow it, so it is granted once over ADB with
             "cmd notification allow_listener app.glasshome.launcher/app.glasshome.launcher.MediaWatcher". -->
        <service
            android:name=".MediaWatcher"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Control Center Sleep: allowed only to turn the screen off; granted once over ADB with
             "dpm set-active-admin app.glasshome.launcher/.SleepAdmin" and given back from Home Screen settings -->
        <receiver
            android:name=".SleepAdmin"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/sleep_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SleepTimerReceiver"
            android:exported="false" />
    </application>
</manifest>
