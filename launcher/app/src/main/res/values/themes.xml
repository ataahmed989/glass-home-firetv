<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <!-- The cover over the trip back from the Home button (HomeButtonService), faded by Fire OS itself:
         in over the black on the way back from another app, out once Glass Home is drawn beneath -->
    <style name="CoverFadeIn">
        <item name="android:windowEnterAnimation">@anim/cover_in</item>
        <item name="android:windowExitAnimation">@anim/cover_out</item>
    </style>

    <!-- Over Glass Home itself, still on screen: up at once, faded out -->
    <style name="CoverAtOnce">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@anim/cover_out</item>
    </style>
</resources>
