<?xml version="1.0" encoding="utf-8"?>
<!-- Home button: told which app's window comes to the front and when Amazon's launcher redraws, and
     shown the remote's keys, which it never consumes; never reads window content -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/home_button_service"
    android:notificationTimeout="0" />
